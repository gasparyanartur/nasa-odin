{
  "name": "martian-map",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:api": "node scripts/python.mjs-m unittest discover -s server/tests -v",
    "dev:all": "node scripts/run.mjs",
    "demo": "node scripts/run.mjs --preview",
    "prepare:data": "node scripts/python.mjsscripts/prepare_gale.py && node scripts/python.mjsscripts/prepare_environment.py",
    "record:demo": "node scripts/record-demo.mjs",
    "prepare:science": "node scripts/python.mjsscripts/prepare_science.py",
    "prepare:environment": "node scripts/python.mjsscripts/prepare_environment_release.py",
