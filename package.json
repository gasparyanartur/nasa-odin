{
  "name": "martian-map",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:api": ".venv/bin/python -m unittest discover -s server/tests -v",
    "dev:all": "node scripts/run.mjs",
    "demo": "node scripts/run.mjs --preview",
    "prepare:data": ".venv/bin/python scripts/prepare_gale.py && .venv/bin/python scripts/prepare_environment.py",
    "record:demo": "node scripts/record-demo.mjs",
    "prepare:science": ".venv/bin/python scripts/prepare_science.py"
  },
  "dependencies": {
    "@react-three/fiber": "^9.8.2",
    "cesium": "^1.147.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^5.1.0"
  }
